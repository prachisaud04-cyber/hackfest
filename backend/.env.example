# HackFest 2026 - Backend Environment Configuration Example
# Copy this file to .env and replace the placeholders.

# Server Port (Default: 5000)
PORT=5000

# MongoDB Atlas Connection String (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/hackfest?retryWrites=true&w=majority

# Client / Frontend URL (For CORS & email links)
CLIENT_URL=http://localhost:3000

# ==========================================
# Optional: Automated Email Notifications (SMTP)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# EMAIL_FROM=HackFest 2026 <no-reply@hackfest.org>

# ==========================================
# Optional: Real-time Discord / Slack Webhooks
# ==========================================
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
