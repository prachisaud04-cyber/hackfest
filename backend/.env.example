# HackFest 2026 - Backend Environment Configuration Example
# Copy this file to .env and replace the placeholder with your MongoDB Atlas connection string.

# Server Port (Default: 5000)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/hackfest?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/hackfest?retryWrites=true&w=majority

# Optional: CORS Allowed Origins (comma-separated if customized)
CLIENT_URL=http://localhost:3000
